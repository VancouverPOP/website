{
    "$schema": "https://raw.githubusercontent.com/devcontainers/spec/refs/heads/main/schemas/devContainer.schema.json",
    "name": "Debian Container (arm64)",
    "remoteUser": "dev",
    "containerUser": "dev",
    "workspaceMount": "source=${localWorkspaceFolder},target=/home/dev/workspace,type=bind",
    "workspaceFolder": "/home/dev/workspace",
    "postCreateCommand": "pnpm i --frozen-lockfile",
    "build": {
        "dockerfile": "../Dockerfile",
        "args": {
            "PLATFORM": "linux/arm64",
            "NODE_PLATFORM": "linux-arm64"
        }
    },
    "appPort": ["4321:4321"],
    "customizations": {
        "vscode": {
            "settings": {
                "extensions.verifySignature": true,
                "npm.packageManager": "pnpm"
            },
            "extensions": [
                "astro-build.astro-vscode",
                "redhat.vscode-yaml",
                "DavidAnson.vscode-markdownlint",
                "unifiedjs.vscode-mdx",
                "eliostruyf.vscode-front-matter",
                "bradlc.vscode-tailwindcss",
                "eamodio.gitlens"
            ]
        }
    }
}
